{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": ["**", "!pnpm-lock.yaml", "!**/paraglide"]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single"
    }
  },
  "linter": {
    "rules": {
      "preset": "recommended",
      "security": {
        "noDangerouslySetInnerHtml": "error"
      },
      "style": {
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "paths": {
              "react-aria-components": "Import components from @micorra/ui; React Aria is used only inside packages/ui.",
              "react-aria": "Import components from @micorra/ui; React Aria is used only inside packages/ui.",
              "react-stately": "Import components from @micorra/ui; React Aria is used only inside packages/ui."
            },
            "patterns": [
              {
                "group": ["@react-aria/**", "@react-stately/**"],
                "message": "Import components from @micorra/ui; React Aria is used only inside packages/ui."
              }
            ]
          }
        }
      }
    }
  },
  "overrides": [
    {
      "includes": ["packages/ui/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": "off"
          }
        }
      }
    }
  ]
}
